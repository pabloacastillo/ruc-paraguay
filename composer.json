{
    "name": "martinpa13py/ruc-paraguay",
    "description": "This a fork from pabloacastillo/ruc-paraguay that works with Laravel 11+",
    "keywords": ["laravel", "ruc", "paraguay", "taxes"],
    "license": "MIT",
    "authors": [
        {
            "name": "Pablo A. Castillo",
            "email": "pabloacastillo@gmail.com"
        },
        {
            "name": "Martin Victor Antonio Martinez Paredes",
            "email": "martinpa13_py@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "martinpa13py\\RUCParaguay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "martinpa13py\\RUCParaguay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "martinpa13py\\RUCParaguay\\RUCParaguayServiceProvider"
            ],
            "aliases": {
                "RUCParaguay": "martinpa13py\\RUCParaguay\\Facades\\RUCParaguayFacade"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
